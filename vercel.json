{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/article.html",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(.*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|TelegramBot|LinkedInBot|Slackbot|Discordbot|SkypeUriPreview|Googlebot|bingbot|crawler|spider|bot).*)"
        }
      ],
      "destination": "/api/og"
    },
    {
      "source": "/article",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(.*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|TelegramBot|LinkedInBot|Slackbot|Discordbot|SkypeUriPreview|Googlebot|bingbot|crawler|spider|bot).*)"
        }
      ],
      "destination": "/api/og"
    },
    { "source": "/article", "destination": "/article.html" },
    {
      "source": "/story/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(.*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|TelegramBot|LinkedInBot|Slackbot|Discordbot|SkypeUriPreview|Googlebot|bingbot|crawler|spider|bot).*)"
        }
      ],
      "destination": "/api/og?id=:id"
    },
    { "source": "/story/:id", "destination": "/article.html?id=:id" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/profile/author/:id", "destination": "/author.html?id=:id" },
    { "source": "/profile/author", "destination": "/author.html" },
    { "source": "/author/:id", "destination": "/author.html?id=:id" },
    { "source": "/author", "destination": "/author.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
