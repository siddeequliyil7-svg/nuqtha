{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/profile/author/:id", "destination": "/author.html?id=:id" },
    { "source": "/profile/author", "destination": "/author.html" },
    { "source": "/author/:id", "destination": "/author.html?id=:id" },
    { "source": "/author", "destination": "/author.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
